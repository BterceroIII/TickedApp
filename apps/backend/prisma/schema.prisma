// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  EN_PROGRESO   @map("En Progreso")
  EN_REVISION   @map("En Revision")
  PLANIFICACION
  COMPLETADO    @map("Completado")
}

enum TicketStatus {
  ABIERTO    @map("Abierto")
  EN_PROCESO @map("En proceso")
  RESUELTO   @map("Resuelto")
}

enum TicketPriority {
  ALTA  @map("Alta")
  MEDIA @map("Media")
  BAJA  @map("Baja")
}

model Project {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(120)
  description   String?       @db.VarChar(500)
  status        ProjectStatus @default(PLANIFICACION)
  responsibleId String        @db.Uuid
  responsible   User          @relation(fields: [responsibleId], references: [id])
  dateLimit     DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tickets       Ticket[]

  @@index([responsibleId])
  @@index([status])
  @@map("projects")
}

model Ticket {
  id          String         @id
  projectId   Int
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String         @db.VarChar(150)
  description String?        @db.VarChar(500)
  status      TicketStatus   @default(ABIERTO)
  priority    TicketPriority @default(MEDIA)
  estimatedDate DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@map("tickets")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  name      String?   @db.VarChar(120)
  email     String    @unique @db.VarChar(254)
  password  String    @db.VarChar(255)
  token     String?   @unique @db.VarChar(6)
  confirmed Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@map("users")
}
